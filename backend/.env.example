# Basera backend — local environment template
# Copy to backend/.env and fill in values. Never commit backend/.env.
#
# Google OAuth (optional locally — omit all GOOGLE_* vars to keep mock integrations):
#   1. Google Cloud Console → enable People API + Gmail API
#   2. OAuth client type: Web application
#   3. Authorized redirect URIs (must match exactly):
#        http://localhost:8000/api/integrations/google-contacts/callback
#        http://localhost:8000/api/integrations/gmail/callback
#   4. While the OAuth consent screen is in "Testing", add your Google account
#      under Test users on the consent screen.
#   5. JavaScript origins are NOT required (OAuth uses backend redirect only).
#
# Provider mode: leave INTEGRATIONS_*_PROVIDER unset — the server auto-selects
# "google" when credentials below are complete, otherwise "mock".
# Do NOT set INTEGRATIONS_CONTACTS_PROVIDER=google or INTEGRATIONS_GMAIL_PROVIDER=google
# unless all required GOOGLE_* variables for that integration are filled.
#
# Secrets: never commit GOOGLE_CLIENT_SECRET or INTEGRATIONS_TOKEN_KEY.
# Use a dedicated INTEGRATIONS_TOKEN_KEY (≥32 chars); do not reuse JWT_SECRET.
# Changing INTEGRATIONS_TOKEN_KEY invalidates tokens already encrypted in MongoDB.

# --- Google OAuth (optional — mock mode when unset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google-contacts/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback

# Public URLs used for OAuth callbacks and post-consent redirect to the dashboard
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# Dedicated Fernet-compatible secret for encrypting OAuth tokens at rest (local dev:
# generate once and keep stable across restarts if you reconnect Google accounts)
INTEGRATIONS_TOKEN_KEY=

# Optional overrides (defaults are fine for most setups)
# INTEGRATIONS_CONTACTS_PROVIDER=mock
# INTEGRATIONS_GMAIL_PROVIDER=mock
# GOOGLE_CONTACTS_SCOPES=https://www.googleapis.com/auth/contacts.readonly openid email profile
# GOOGLE_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly openid email profile

# --- Phone Hub (architecture; mock by default — no live carrier) ---
# Phone Hub V2 — product mode is manual journal + CSV (no live carrier).
# INTEGRATIONS_PHONE_PROVIDER=mock
# INTEGRATIONS_PHONE_MOCK=true
# PHONE_SYNC_MAX_CALLS=100
# Carrier connectors (Twilio / Ringover / Aircall / OVH / …) stay stubs — do not wire yet.
# Future vendors (interfaces only until wired):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# AIRCALL_API_ID=
# AIRCALL_API_TOKEN=
# RINGOVER_API_KEY=
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=
# THREECX_API_URL=
# THREECX_API_TOKEN=
# FREEPBX_AMI_HOST=
# FREEPBX_AMI_SECRET=

# --- Gmail auto-sync (scheduler) ---
# Used by scripts/run_scheduled_tasks.py. No secrets. Interval never below 5 minutes.
GMAIL_AUTO_SYNC_ENABLED=true
GMAIL_AUTO_SYNC_INTERVAL_MINUTES=10
GMAIL_AUTO_SYNC_BATCH_SIZE=25
GMAIL_AUTO_SYNC_TIMEOUT_SECONDS=60

# --- Action Engine (channel-agnostic, no AI) ---
ACTION_ENGINE_ENABLED=true
ACTION_RULE_REPLY_TO_PROSPECT=true
ACTION_RULE_READ_CLIENT_REPLY=true
ACTION_RULE_CALL_BACK=true
ACTION_RULE_FOLLOW_UP_OVERDUE_INVOICE=true
ACTION_RULE_CREATE_INVOICE_FROM_QUOTE=true

# --- Communication Intelligence (AI suggests; user decides) ---
# Off by default. Auto-on-ingest stays off unless explicitly enabled (no mass prod run).
COMMUNICATION_INTELLIGENCE_ENABLED=false
COMMUNICATION_INTELLIGENCE_AUTO_ON_INGEST=false
COMMUNICATION_INTELLIGENCE_PROVIDER=mock
# COMMUNICATION_INTELLIGENCE_PROVIDER=openai
# COMMUNICATION_INTELLIGENCE_MODEL=gpt-4o-mini
COMMUNICATION_INTELLIGENCE_TIMEOUT=30
COMMUNICATION_INTELLIGENCE_MAX_CHARS=2500
COMMUNICATION_INTELLIGENCE_DAILY_LIMIT=40

# --- Stripe (subscriptions) ---
# Secrets: never commit STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET.
# Checkout is server-side — the app does NOT use a publishable key (pk_…) today.
# Put sk_test_/sk_live_ only in backend/.env (this file is a template).
#
# Plan mapping (API ids unchanged):
#   solo  = Starter  4,90 €/mois  → STRIPE_PRICE_SOLO
#   pro   = Pro      9,90 €/mois  → STRIPE_PRICE_PRO
#   team  = Business 19,90 €/mois → STRIPE_PRICE_TEAM
#
# Current Basera Price IDs (Dashboard):
#   Starter  price_1U0ogXH44aox1nDPS97Gx7Vg  (prod_V0qNNdD2ykwbQk)
#   Pro      price_1U0ogjH44aox1nDPsQvh4rgY  (prod_V0qNzCQW7w0AJc)
#   Business price_1U0ogwH44aox1nDPIqCVldxr  (prod_V0qNPuHEeAnv9s)

STRIPE_SECRET_KEY=
# Webhook optional for Checkout testing — required only to activate subs after payment.
# STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=price_1U0ogXH44aox1nDPS97Gx7Vg
STRIPE_PRICE_PRO=price_1U0ogjH44aox1nDPsQvh4rgY
STRIPE_PRICE_TEAM=price_1U0ogwH44aox1nDPIqCVldxr
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/dashboard/billing?checkout=cancel

# Optional — Product IDs (reference only; checkout uses Price IDs)
# STRIPE_PRODUCT_SOLO=prod_V0qNNdD2ykwbQk
# STRIPE_PRODUCT_PRO=prod_V0qNzCQW7w0AJc
# STRIPE_PRODUCT_TEAM=prod_V0qNPuHEeAnv9s

# Optional — Admin MRR estimates (must match catalog)
# ADMIN_MRR_SOLO_EUR=4.9
# ADMIN_MRR_PRO_EUR=9.9
# ADMIN_MRR_TEAM_EUR=19.9
