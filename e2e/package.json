{
  "name": "basera-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright E2E suite for Basera product journeys",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-360 --project=mobile-390 --project=mobile-412",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:main": "playwright test tests/prospect-to-client.spec.js --project=chromium",
    "test:accessibility": "playwright test tests/accessibility.spec.js --project=chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "axe-core": "^4.10.3",
    "@axe-core/playwright": "^4.10.1"
  }
}
