# Basera — production environment template
# Copy to deploy/.env and replace every CHANGE_ME.
# Never commit deploy/.env.
#
# Official domain (when DNS + TLS are ready): https://basera.fr
# Do not point DNS until the VPS stack is validated.
#
# Launch (OVH / VPS):
#   docker compose -f docker-compose.yml -f docker-compose.production.yml --env-file deploy/.env up -d --build
# Guide: deploy/OVH_VPS_DEPLOY.md

# --- Runtime ---
ENV=production
IMAGE_TAG=local
HTTP_PORT=80
HTTPS_PORT=443

# --- Public URLs (same origin behind nginx) ---
PUBLIC_APP_URL=https://basera.fr
FRONTEND_URL=https://basera.fr
FRONTEND_PUBLIC_URL=https://basera.fr
BACKEND_PUBLIC_URL=https://basera.fr
PORTAL_BASE_URL=https://basera.fr
CORS_ORIGINS=https://basera.fr

# --- Security ---
JWT_SECRET=CHANGE_ME_random_at_least_32_chars
SENTRY_USER_SALT=CHANGE_ME_random_sentry_salt
# SENTRY_DSN=

# --- MongoDB (docker-compose.production.yml injects MONGO_URL with auth) ---
MONGO_ROOT_USERNAME=CHANGE_ME_mongo_user
MONGO_ROOT_PASSWORD=CHANGE_ME_strong_mongo_password
DB_NAME=basera

# --- Storage (volume uploads_data → /app/uploads) ---
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=26214400

# --- Product / AI ---
CREDITS_ENFORCED=true
ANALYZER_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME_sk_or_project_key
MAX_LIST_ITEMS=200

# --- Email (SMTP required in production) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=CHANGE_ME_smtp_host
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=noreply@basera.fr
SMTP_FROM_NAME=Basera
SUPPORT_EMAIL=support@basera.fr

# --- Stripe Live ---
# Checkout uses Price IDs only (never Product IDs in code).
# Plan mapping: solo=Starter, pro=Pro, team=Business
STRIPE_SECRET_KEY=CHANGE_ME_sk_live_
# Webhook: configure ONLY after HTTPS on basera.fr →
#   https://basera.fr/api/stripe/webhook
# Until then, set any non-empty placeholder so the backend can start, e.g.:
#   STRIPE_WEBHOOK_SECRET=whsec_pending_configure_after_https
# Replace with the real whsec_… from Stripe Dashboard afterwards.
STRIPE_WEBHOOK_SECRET=CHANGE_ME_whsec_
STRIPE_PRICE_SOLO=price_1U0ogXH44aox1nDPS97Gx7Vg
STRIPE_PRICE_PRO=price_1U0ogjH44aox1nDPsQvh4rgY
STRIPE_PRICE_TEAM=price_1U0ogwH44aox1nDPIqCVldxr
STRIPE_SUCCESS_URL=https://basera.fr/dashboard/billing?checkout=success
STRIPE_CANCEL_URL=https://basera.fr/dashboard/billing?checkout=cancel

# Optional credit packs (if used)
# STRIPE_PRICE_CREDITS_10=
# STRIPE_PRICE_CREDITS_25=
# STRIPE_PRICE_CREDITS_50=

# --- Frontend build args (compose passes these into the SPA image) ---
# REACT_APP_API_URL is set from PUBLIC_APP_URL (same-origin /api via nginx).
# REACT_APP_SENTRY_DSN=
# REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Google OAuth (optional — omit all GOOGLE_* to keep integrations off) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://basera.fr/api/integrations/google-contacts/callback
# GOOGLE_GMAIL_REDIRECT_URI=https://basera.fr/api/integrations/gmail/callback
# INTEGRATIONS_TOKEN_KEY=CHANGE_ME_dedicated_fernet_secret_32plus

# --- Gmail auto-sync (scheduler service) — no secrets ---
# Recreate scheduler after changing these (see docs/PRODUCTION_DEPLOYMENT.md).
GMAIL_AUTO_SYNC_ENABLED=true
GMAIL_AUTO_SYNC_INTERVAL_MINUTES=10
GMAIL_AUTO_SYNC_BATCH_SIZE=25
GMAIL_AUTO_SYNC_TIMEOUT_SECONDS=60

# --- Action Engine (defaults to enabled in code if unset) ---
ACTION_ENGINE_ENABLED=true
# ACTION_RULE_REPLY_TO_PROSPECT=true
# ACTION_RULE_READ_CLIENT_REPLY=true
# ACTION_RULE_CALL_BACK=true
# ACTION_RULE_FOLLOW_UP_OVERDUE_INVOICE=true
# ACTION_RULE_CREATE_INVOICE_FROM_QUOTE=true

# --- Communication Intelligence (keep OFF until explicitly enabled) ---
COMMUNICATION_INTELLIGENCE_ENABLED=false
COMMUNICATION_INTELLIGENCE_AUTO_ON_INGEST=false
# If enabling CI, provider MUST be openai (mock is rejected when deployed):
# COMMUNICATION_INTELLIGENCE_ENABLED=true
# COMMUNICATION_INTELLIGENCE_PROVIDER=openai
# COMMUNICATION_INTELLIGENCE_MODEL=gpt-4o-mini

# --- E2E / local-only — NEVER set in production ---
# ALLOW_E2E_SEED=
# E2E_DISABLE_RATE_LIMIT=
# E2E_DB_NAME=
# DB_NAME must be the product DB (e.g. basera), never memoryhub_e2e
