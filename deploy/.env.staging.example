# Basera — staging environment template
# Copy to deploy/.env (on the staging host) and replace every CHANGE_ME.
# Never commit deploy/.env.
#
# Suggested host: https://staging.basera.fr (DNS not required until ready)
#
# Launch:
#   docker compose -f docker-compose.yml -f docker-compose.staging.yml --env-file deploy/.env up -d --build

# --- Runtime ---
ENV=staging
IMAGE_TAG=local
HTTP_PORT=80
HTTPS_PORT=443
PLAIN_HTTP_PORT=8080

# --- Public URLs ---
PUBLIC_APP_URL=https://staging.basera.fr
FRONTEND_URL=https://staging.basera.fr
FRONTEND_PUBLIC_URL=https://staging.basera.fr
BACKEND_PUBLIC_URL=https://staging.basera.fr
PORTAL_BASE_URL=https://staging.basera.fr
CORS_ORIGINS=https://staging.basera.fr

# --- Security ---
JWT_SECRET=CHANGE_ME_random_at_least_32_chars
SENTRY_USER_SALT=CHANGE_ME_random_sentry_salt
# SENTRY_DSN=

# --- MongoDB ---
# Staging compose uses a separate volume; auth optional unless you add prod overrides.
MONGO_URL=mongodb://mongo:27017
DB_NAME=basera_staging

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=26214400

# --- Product / AI ---
CREDITS_ENFORCED=true
ANALYZER_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME_sk_or_project_key
MAX_LIST_ITEMS=200

# --- Email ---
EMAIL_PROVIDER=smtp
SMTP_HOST=CHANGE_ME_smtp_host
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=noreply@basera.fr
SMTP_FROM_NAME=Basera Staging
SUPPORT_EMAIL=support@basera.fr

# --- Stripe Test ---
STRIPE_SECRET_KEY=CHANGE_ME_sk_test_
STRIPE_WEBHOOK_SECRET=CHANGE_ME_whsec_test_
STRIPE_PRICE_SOLO=price_1U0ogXH44aox1nDPS97Gx7Vg
STRIPE_PRICE_PRO=price_1U0ogjH44aox1nDPsQvh4rgY
STRIPE_PRICE_TEAM=price_1U0ogwH44aox1nDPIqCVldxr
STRIPE_SUCCESS_URL=https://staging.basera.fr/dashboard/billing?checkout=success
STRIPE_CANCEL_URL=https://staging.basera.fr/dashboard/billing?checkout=cancel
