# Basera frontend — local / build-time variables
# Copy to frontend/.env.local for CRA/craco. Never commit secrets.
#
# In Docker Compose production, these are passed as build args from deploy/.env
# (see docker-compose.yml → frontend.build.args). Same-origin deploy leaves
# REACT_APP_API_URL empty or equal to PUBLIC_APP_URL; the browser calls /api/…
# via nginx, with credentials included.

# API origin. Leave empty in local dev (craco proxy → localhost:8000).
# Production same-origin: https://basera.fr (or empty if always relative /api).
REACT_APP_API_URL=

# development | staging | production
REACT_APP_ENV=development

# Optional Sentry
# REACT_APP_SENTRY_DSN=
# REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.1
# REACT_APP_SENTRY_USER_SALT=

# Dev-only: override API proxy target (craco)
# REACT_APP_DEV_API_PROXY=http://127.0.0.1:8000
